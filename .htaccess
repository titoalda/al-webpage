# Apache configuration for Clean URLs (stripping .html extensions)
RewriteEngine On

# Explicit rules for directories that conflict with pages
RewriteRule ^projects/?$ projects.html [L]
RewriteRule ^projects/casacuentos/?$ projects/casacuentos.html [L]

# 1. Redirect direct requests to /page.html to clean URL /page
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Internally route clean URL request /page back to /page.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
